#!/bin/sh
# Rebuild docs/ whenever a commit touches what it is built from, so docs/ never goes stale.
# Enable once per clone: git config core.hooksPath .githooks   (skip with: git commit --no-verify)
git diff --cached --name-only | grep -Eq '^(questions/|src/|pages/|build\.py$)' || exit 0
"$(dirname "$0")/_build" || { echo "pre-commit: build.py failed, commit aborted" >&2; exit 1; }
git add docs
